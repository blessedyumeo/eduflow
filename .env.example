# ---------- База данных ----------
# Локально: docker run --name eduflow-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=eduflow -p 5432:5432 -d postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eduflow?schema=public"

# ---------- Аутентификация ----------
# Любая длинная случайная строка. Сгенерировать: openssl rand -base64 32
AUTH_SECRET="change-me-please-to-a-long-random-string"

# ---------- Адрес сайта ----------
APP_URL="http://localhost:3000"

# ---------- Платежи ----------
# mock      — встроенная эмуляция платежа, работает без ключей (удобно для демо/портфолио)
# yookassa  — реальная интеграция с ЮKassa (тестовый или боевой магазин)
PAYMENT_MODE="mock"

YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""

# ---------- Первый администратор (используется сидом) ----------
ADMIN_EMAIL="admin@eduflow.ru"
ADMIN_PASSWORD="admin12345"
